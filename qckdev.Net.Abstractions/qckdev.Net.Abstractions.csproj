<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net10.0;net9.0;net8.0;net7.0;net6.0;net5.0;netstandard2.0;netstandard1.2;net461;net451;$(net45);$(net40);$(net35)</TargetFrameworks>
		<VersionSuffix>$(VersionSuffix)</VersionSuffix>
		<Version>2.0.0-net10.1</Version>
		<!--<Version Condition=" '$(VersionSuffix)' != '' ">$(Version)-$(VersionSuffix)</Version>-->
		<Company>TrCode</Company>
		<Authors>hfrances</Authors>
		<RootNamespace>qckdev.Net</RootNamespace>
		<Description>Provides abstractions for qckdev.Net and qckdev.Net.Http namespaces.</Description>
		<Product>qckdev.Net.Abstractions</Product>
		<PackageId>qckdev.Net.Abstractions</PackageId>
		<RootNamespace>qckdev.Net</RootNamespace>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://github.com/hfrances/qckdev.Net.Http</PackageProjectUrl>
		<NoWarn>$(NoWarn);NETSDK1215;CS1574</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net35'">
		<AssemblyName>$(MSBuildProjectName).2</AssemblyName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' != 'net35'">
		<AssemblyName>$(MSBuildProjectName)</AssemblyName>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net35'">
		<DefineConstants>$(DefineConstants);NO_ASYNC;NO_HTTP;NO_DYNAMIC</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='net40'">
		<DefineConstants>$(DefineConstants);NO_HTTP;NO_ASYNC</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)'=='netstandard1.2'">
		<DefineConstants>$(DefineConstants);NO_DYNAMIC;NO_SYNC;NO_WEB</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='netstandard1.2' or '$(TargetFramework)'=='net461' or '$(TargetFramework)'=='net451' or '$(TargetFramework)'=='net45'">
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net40' or '$(TargetFramework)'=='net35'">
		<Reference Include="System.Net" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="qckdev.Text.Json" Version="1.3.0-net10" />
	</ItemGroup>
  
  	<ItemGroup>
    	<None Include="..\README.md" Pack="true" PackagePath="\" />
    	<None Include="..\LICENSE" Pack="true" PackagePath="\" />
  	</ItemGroup>
</Project>